<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Help Center &amp; Documentation — Orain Labs</title>
    <meta name="description" content="Central documentation, technical guidance, API references for PAXX 1.0, kernel architecture, enterprise deployment, and support for ORAIN Geometric Intelligence.">

    <!-- Typography: Instrument Sans for UI, JetBrains Mono for Technical Data -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* =====================================================================
           1. CORE SYSTEM & VARIABLES (DARK MODE DEFAULT)
           ===================================================================== */
        :root {
            --bg-base: #0a0a0a;
            --bg-base-rgb: 10, 10, 10;
            --bg-soft: #141414;
            --bg-surface: #1e1e1e;

            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;

            --line: #2a2a2a;
            --line-light: #1a1a1a;

            --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --nav-height: 80px;
            --subnav-height: 52px;
        }

        body.light-mode {
            --bg-base: #ffffff;
            --bg-base-rgb: 255, 255, 255;
            --bg-soft: #fcfcfc;
            --bg-surface: #f5f5f4;

            --text-primary: #000000;
            --text-secondary: #555555;
            --text-muted: #888888;

            --line: #e5e5e5;
            --line-light: #f0f0f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            font-family: var(--font-sans);
            font-size: 16px;
            overflow-x: hidden;
        }

        body {
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        /* =====================================================================
           2. TYPOGRAPHY & UTILITIES
           ===================================================================== */
        .container {
            width: min(1320px, calc(100% - 4rem));
            margin: 0 auto;
            position: relative;
        }

        .label-sm {
            display: inline-block;
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 600;
            font-family: var(--font-mono);
        }

        .headline-xl {
            color: var(--text-primary);
            font-size: clamp(2.4rem, 5vw, 4.4rem);
            font-weight: 500;
            letter-spacing: -0.04em;
            line-height: 1.15;
            margin-bottom: 1.5rem;
        }

        .headline-md {
            color: var(--text-primary);
            font-size: clamp(1.8rem, 3.2vw, 2.6rem);
            font-weight: 500;
            letter-spacing: -0.03em;
            line-height: 1.2;
            margin-bottom: 1.25rem;
        }

        .headline-sm {
            color: var(--text-primary);
            font-size: 1.3rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            margin-bottom: 0.8rem;
        }

        .body-lg {
            color: var(--text-secondary);
            font-size: clamp(1.05rem, 1.3vw, 1.2rem);
            font-weight: 400;
            line-height: 1.65;
            max-width: 780px;
        }

        .body-md {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .link-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            padding-bottom: 3px;
            border-bottom: 1px solid var(--text-primary);
            margin-top: 1.5rem;
            cursor: pointer;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
            font-family: var(--font-sans);
        }

        .link-cta:hover {
            opacity: 0.6;
        }

        .reveal {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =====================================================================
           3. PRIMARY NAVIGATION & HELP SUB-NAV
           ===================================================================== */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            height: var(--nav-height);
            z-index: 100;
            background: rgba(var(--bg-base-rgb), 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
        }

        .nav-container {
            display: flex;
            height: 100%;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 2.2rem;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--text-primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .theme-toggle-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            transition: background-color 0.2s ease;
        }
        
        .theme-toggle-btn:hover {
            background-color: var(--line-light);
        }

        /* Sticky Help Center Sub-Navigation */
        .subnav-bar {
            position: sticky;
            top: var(--nav-height);
            width: 100%;
            height: var(--subnav-height);
            z-index: 90;
            background: rgba(var(--bg-base-rgb), 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--line-light);
        }

        .subnav-container {
            display: flex;
            align-items: center;
            gap: 2rem;
            height: 100%;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .subnav-container::-webkit-scrollbar { display: none; }

        .subnav-link {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 0.4rem 0;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .subnav-link:hover {
            color: var(--text-primary);
        }

        .subnav-link.active {
            color: var(--text-primary);
            border-bottom-color: var(--text-primary);
        }

        /* =====================================================================
           4. TAB PANEL SWITCHING SYSTEM
           ===================================================================== */
        .tab-panel {
            display: none;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

        .tab-panel.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
            animation: panelFadeIn 0.35s ease forwards;
        }

        @keyframes panelFadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .help-hero {
            padding-top: calc(var(--nav-height) + 2rem);
            padding-bottom: 5rem;
            border-bottom: 1px solid var(--line-light);
            background: radial-gradient(circle at 80% 20%, var(--bg-soft) 0%, var(--bg-base) 70%);
        }

        .section-block {
            padding: 6rem 0;
            border-bottom: 1px solid var(--line-light);
        }

        .tab-panel > .section-block:first-child:not(.help-hero) {
            padding-top: calc(var(--nav-height) + 2rem);
        }

        /* =====================================================================
           5. SEARCH & QUICK DIRECTORY GRID
           ===================================================================== */
        .search-wrapper {
            margin-top: 2.5rem;
            position: relative;
            max-width: 680px;
        }

        .search-input {
            width: 100%;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 1rem 1.2rem 1rem 3rem;
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .search-input:focus {
            border-color: var(--text-muted);
            box-shadow: 0 0 0 1px var(--text-muted);
        }

        .search-icon {
            position: absolute;
            left: 1.1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        /* Directory Cards (Grid Inspired by Documentation Structure) */
        .directory-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            margin-top: 3.5rem;
        }

        .dir-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 2rem;
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            cursor: pointer;
            transition: border-color 0.25s ease, transform 0.25s ease;
        }

        .dir-card:hover {
            border-color: var(--text-muted);
            transform: translateY(-3px);
        }

        .dir-icon-box {
            background: var(--bg-base);
            border: 1px solid var(--line);
            width: 44px;
            height: 44px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--text-primary);
        }

        .dir-content h3 {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 0.35rem;
        }

        .dir-content p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        /* Progression Tracker Strip */
        .progression-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 1.5rem 2rem;
            margin-top: 3.5rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .progression-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: var(--text-primary);
        }

        .progression-item span {
            color: var(--text-muted);
        }

        .progression-arrow {
            color: var(--text-muted);
        }

        /* =====================================================================
           6. COMPONENT CARDS, CODE & FAQS
           ===================================================================== */
        .cards-grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }

        .cards-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.8rem;
            margin-top: 3rem;
        }

        .doc-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 260px;
            transition: border-color 0.25s ease;
        }

        .doc-card:hover {
            border-color: var(--text-muted);
        }

        .doc-badge {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-muted);
            letter-spacing: 0.1em;
            margin-bottom: 1.2rem;
            display: block;
        }

        .spec-list {
            list-style: none;
            margin-top: 1.2rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .spec-list li {
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .spec-list li::before {
            content: "•";
            color: var(--text-muted);
        }

        /* Code Block Mockup */
        .code-window {
            background: var(--bg-base);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            line-height: 1.7;
            color: #d1d5db;
            overflow-x: auto;
            margin-top: 1.5rem;
        }

        .code-window .code-comment { color: var(--text-muted); }
        .code-window .code-key { color: #93c5fd; }
        .code-window .code-str { color: #86efac; }
        .code-window .code-num { color: #fca5a5; }

        /* Accordion FAQ Component */
        .faq-accordion {
            margin-top: 3rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .faq-item {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            overflow: hidden;
            transition: border-color 0.2s ease;
        }

        .faq-item:hover {
            border-color: var(--text-muted);
        }

        .faq-trigger {
            width: 100%;
            padding: 1.4rem 1.8rem;
            background: none;
            border: none;
            text-align: left;
            font-family: var(--font-sans);
            font-size: 1.05rem;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }

        .faq-arrow {
            font-family: var(--font-mono);
            font-size: 1rem;
            color: var(--text-muted);
            transition: transform 0.25s ease;
        }

        .faq-item.open .faq-arrow {
            transform: rotate(180deg);
        }

        .faq-content {
            display: none;
            padding: 0 1.8rem 1.6rem 1.8rem;
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .faq-item.open .faq-content {
            display: block;
        }

        /* =====================================================================
           7. SUPPORT FORM & NOTICE
           ===================================================================== */
        .support-layout {
            display: grid;
            grid-template-columns: 1fr 1.3fr;
            gap: 4rem;
            margin-top: 3.5rem;
        }

        .support-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 3rem;
        }

        .form-group {
            margin-bottom: 1.8rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .form-label {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .form-input, .form-select, .form-textarea {
            background: var(--bg-base);
            border: 1px solid var(--line);
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 0.95rem;
            padding: 0.85rem 1rem;
            border-radius: 4px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            border-color: var(--text-primary);
        }

        .form-textarea {
            min-height: 140px;
            resize: vertical;
        }

        .form-notice {
            background: var(--bg-base);
            border-left: 3px solid var(--text-muted);
            padding: 1rem 1.2rem;
            font-size: 0.82rem;
            color: var(--text-secondary);
            font-family: var(--font-mono);
            margin-bottom: 1.8rem;
            line-height: 1.5;
        }

        .btn-submit {
            background: var(--text-primary);
            color: var(--bg-base);
            border: none;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            font-weight: 500;
            padding: 1rem 2rem;
            border-radius: 4px;
            cursor: pointer;
            transition: opacity 0.2s ease;
            width: 100%;
        }

        .btn-submit:hover {
            opacity: 0.85;
        }

        /* Confirmation Notice */
        .confirm-box {
            display: none;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 3rem;
            text-align: center;
        }

        /* =====================================================================
           8. FOOTER
           ===================================================================== */
        footer {
            padding: 6rem 0 3rem;
            background: var(--bg-base);
            border-top: 1px solid var(--line);
            font-size: 0.85rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 5rem;
        }

        .footer-brand {
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .footer-brand + p {
            margin-top: 0.5rem;
            max-width: 220px;
            color: var(--text-secondary);
        }

        .footer-email {
            display: inline-block;
            margin-top: 1.4rem;
            color: var(--text-primary);
            font-weight: 500;
            border-bottom: 1px solid var(--line);
            padding-bottom: 2px;
        }

        .footer-col {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .footer-col h4 {
            margin-bottom: 0.3rem;
            color: var(--text-muted);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .footer-col a {
            color: var(--text-secondary);
            padding: 0.2rem 0;
            cursor: pointer;
        }

        .footer-col a:hover {
            color: var(--text-primary);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            border-top: 1px solid var(--line-light);
            padding-top: 2rem;
            font-size: 0.8rem;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .nav-links { display: none; }
            .directory-grid, .cards-grid-3 { grid-template-columns: repeat(2, 1fr); }
            .support-layout { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .container { width: calc(100% - 2.5rem); }
            .directory-grid, .cards-grid-2, .cards-grid-3, .form-row { grid-template-columns: 1fr; }
            .support-card { padding: 1.8rem; }
            .progression-strip { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
        }
    </style>
</head>
