             1. TAB: ORAIN FUNDAMENTALS & GETTING STARTED
             ============================================================= -->
        <div id="orain" class="tab-panel active">
            <!-- Hero -->
            <section class="help-hero">
                <div class="container">
                    <span class="label-sm">CENTRAL DOCUMENTATION &amp; KNOWLEDGE BASE</span>
                    <h1 class="headline-xl">Documentation, Technical Guidance, and Support</h1>
                    <p class="body-lg">
                        The central knowledge hub for ORAIN — The Geometric Intelligence and the technologies that power it. Built for engineers discovering the platform, developers integrating via PAXX, and enterprise deployment teams.
                    </p>

                    <!-- Search Mockup Bar -->
                    <div class="search-wrapper">
                        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
