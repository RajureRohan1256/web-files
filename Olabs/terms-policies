    <!-- Interactive Navigation, Theme, Sticky Subnav & Swipe Gestures Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            /* 1. Theme Toggle */
            const themeBtn = document.getElementById('theme-toggle');
            const sunIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>`;
            const moonIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>`;

            themeBtn.addEventListener('click', () => {
                document.body.classList.toggle('light-mode');
                themeBtn.innerHTML = document.body.classList.contains('light-mode') ? moonIcon : sunIcon;
            });

            /* 2. Tab Section Switching System */
            const tabPanels = Array.from(document.querySelectorAll('.tab-panel'));
            const subnavLinks = Array.from(document.querySelectorAll('.subnav-link'));
            const subnavContainer = document.getElementById('subnav-scroll-container');
            const tabTriggerLinks = document.querySelectorAll('a[href^="#"]');
            const tabIds = tabPanels.map(p => p.id);

            function triggerReveals(panel) {
                const reveals = panel.querySelectorAll('.reveal');
                reveals.forEach(el => el.classList.add('visible'));
            }

            // Scroll the active tab button into center view in the horizontal subnav
            function centerActiveSubnavLink(activeLink) {
                if (!subnavContainer || !activeLink) return;
                const containerWidth = subnavContainer.offsetWidth;
                const linkLeft = activeLink.offsetLeft;
                const linkWidth = activeLink.offsetWidth;
                const scrollPos = linkLeft - (containerWidth / 2) + (linkWidth / 2);
                subnavContainer.scrollTo({
                    left: scrollPos,
                    behavior: 'smooth'
                });
            }

            function activateTab(tabId, updateHash = true, direction = null) {
                const cleanId = tabId.replace('#', '');
                const targetPanel = document.getElementById(cleanId);
                
                if (!targetPanel || !targetPanel.classList.contains('tab-panel')) return;

                // Remove active classes
                tabPanels.forEach(panel => {
                    panel.classList.remove('active', 'slide-left', 'slide-right');
                });

                // Add active and directional slide animation
                targetPanel.classList.add('active');
                if (direction === 'next') {
                    targetPanel.classList.add('slide-left');
                } else if (direction === 'prev') {
                    targetPanel.classList.add('slide-right');
                }
                triggerReveals(targetPanel);

                // Update subnav link styles & scroll it into center view
                let activeSubnavLink = null;
                subnavLinks.forEach(link => {
                    if (link.getAttribute('href') === `#${cleanId}`) {
                        link.classList.add('active');
                        activeSubnavLink = link;
                    } else {
                        link.classList.remove('active');
                    }
                });

                if (activeSubnavLink) {
                    centerActiveSubnavLink(activeSubnavLink);
                }

                // Scroll to top smoothly
                window.scrollTo({ top: 0, behavior: 'smooth' });

                // Update URL hash
                if (updateHash) {
                    history.pushState(null, '', `#${cleanId}`);
                }
            }

            // Click listener for all tab navigation anchors
            tabTriggerLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    const targetId = link.getAttribute('href');
                    if (targetId && targetId.startsWith('#') && targetId.length > 1) {
                        const targetElement = document.querySelector(targetId);
                        if (targetElement && targetElement.classList.contains('tab-panel')) {
                            e.preventDefault();
                            activateTab(targetId);
                        }
                    }
                });
            });

            /* 3. Horizontal Touch Swipe Navigation for Mobile/Phone */
            let touchStartX = 0;
            let touchStartY = 0;
            let touchEndX = 0;
            let touchEndY = 0;

            const mainContent = document.getElementById('legal-tab-root');

            mainContent.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
                touchStartY = e.changedTouches[0].screenY;
            }, { passive: true });

            mainContent.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                touchEndY = e.changedTouches[0].screenY;
                handleSwipeGesture();
            }, { passive: true });

            function handleSwipeGesture() {
                const deltaX = touchEndX - touchStartX;
                const deltaY = touchEndY - touchStartY;
                const minSwipeDistance = 55; // Minimum horizontal swipe threshold in px

                // Only trigger if horizontal swipe is dominant over vertical scroll
                if (Math.abs(deltaX) > minSwipeDistance && Math.abs(deltaX) > Math.abs(deltaY) * 1.4) {
                    const activePanel = document.querySelector('.tab-panel.active');
                    if (!activePanel) return;

                    const currentIndex = tabIds.indexOf(activePanel.id);
                    if (currentIndex === -1) return;

                    if (deltaX < 0) {
                        // Swiped Left -> Go to Next Tab
                        if (currentIndex < tabIds.length - 1) {
                            activateTab(tabIds[currentIndex + 1], true, 'next');
                        }
                    } else {
                        // Swiped Right -> Go to Previous Tab
                        if (currentIndex > 0) {
                            activateTab(tabIds[currentIndex - 1], true, 'prev');
                        }
                    }
                }
            }

            // Initial load check from URL hash
            const currentHash = window.location.hash;
            if (currentHash && document.querySelector(currentHash)?.classList.contains('tab-panel')) {
                activateTab(currentHash, false);
            } else {
                activateTab('terms-of-use', false);
            }

            // Browser back/forward button support
            window.addEventListener('popstate', () => {
                const hash = window.location.hash || '#terms-of-use';
                activateTab(hash, false);
            });
        });
    </script>
