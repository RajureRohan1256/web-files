<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Terms &amp; Policies — Orains</title>
    <meta name="description" content="Legal terms, privacy policies, acceptable use frameworks, and governance documentation for Orains and the ORAIN platform.">

    <!-- Typography: Instrument Sans for UI & Legal Prose, JetBrains Mono for Metadata -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* =====================================================================
           1. CORE SYSTEM & VARIABLES (DARK MODE DEFAULT)
           ===================================================================== */
        :root {
            --bg-base: #0a0a0a;
            --bg-base-rgb: 10, 10, 10;
            --bg-soft: #141414;
            --bg-surface: #1e1e1e;

            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;

            --line: #2a2a2a;
            --line-light: #1a1a1a;

            --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --nav-height: 80px;
            --subnav-height: 52px;
        }

        body.light-mode {
            --bg-base: #ffffff;
            --bg-base-rgb: 255, 255, 255;
            --bg-soft: #fcfcfc;
            --bg-surface: #f5f5f4;

            --text-primary: #000000;
            --text-secondary: #555555;
            --text-muted: #888888;

            --line: #e5e5e5;
            --line-light: #f0f0f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            font-family: var(--font-sans);
            font-size: 16px;
            overflow-x: clip;
        }

        body {
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: clip;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        /* =====================================================================
           2. TYPOGRAPHY & UTILITIES
           ===================================================================== */
        .container {
            width: min(1120px, calc(100% - 4rem));
            margin: 0 auto;
            position: relative;
        }

        .label-sm {
            display: inline-block;
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 600;
            font-family: var(--font-mono);
        }

        .headline-xl {
            color: var(--text-primary);
            font-size: clamp(2.2rem, 4.5vw, 3.8rem);
            font-weight: 500;
            letter-spacing: -0.04em;
            line-height: 1.15;
            margin-bottom: 1.25rem;
        }

        .headline-md {
            color: var(--text-primary);
            font-size: clamp(1.4rem, 2.5vw, 1.9rem);
            font-weight: 500;
            letter-spacing: -0.02em;
            line-height: 1.3;
            margin-bottom: 1rem;
        }

        .headline-sm {
            color: var(--text-primary);
            font-size: 1.15rem;
            font-weight: 500;
            letter-spacing: -0.01em;
            margin-bottom: 0.5rem;
        }

        .body-lg {
            color: var(--text-secondary);
            font-size: clamp(1rem, 1.2vw, 1.15rem);
            font-weight: 400;
            line-height: 1.7;
        }

        .body-md {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.7;
        }

        .link-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            padding-bottom: 3px;
            border-bottom: 1px solid var(--text-primary);
            margin-top: 1.5rem;
            cursor: pointer;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
            font-family: var(--font-sans);
        }

        .link-cta:hover {
            opacity: 0.6;
        }

        .reveal {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =====================================================================
           3. PRIMARY NAVIGATION & SUB-NAV (BOTH FIXED ON SCROLL)
           ===================================================================== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: var(--nav-height);
            z-index: 100;
            background: rgba(var(--bg-base-rgb), 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
        }

        .nav-container {
            display: flex;
            height: 100%;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 2.2rem;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--text-primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .theme-toggle-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            transition: background-color 0.2s ease;
        }
        
        .theme-toggle-btn:hover {
            background-color: var(--line-light);
        }

        /* Fixed Legal Sub-Navigation - Pinned right below Header */
        .subnav-bar {
            position: fixed;
            top: var(--nav-height);
            left: 0;
            width: 100%;
            height: var(--subnav-height);
            z-index: 95;
            background: rgba(var(--bg-base-rgb), 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line-light);
        }

        .subnav-container {
            display: flex;
            align-items: center;
            gap: 2rem;
            height: 100%;
            overflow-x: auto;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .subnav-container::-webkit-scrollbar { display: none; }

        .subnav-link {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 0.4rem 0;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            cursor: pointer;
            flex-shrink: 0;
        }

        .subnav-link:hover {
            color: var(--text-primary);
        }

        .subnav-link.active {
            color: var(--text-primary);
            border-bottom-color: var(--text-primary);
        }

        /* =====================================================================
           4. TAB PANEL SWITCHING SYSTEM & SWIPE TRANSITIONS
           ===================================================================== */
        #legal-tab-root {
            /* Offset content below both fixed headers */
            padding-top: calc(var(--nav-height) + var(--subnav-height));
            touch-action: pan-y pinch-zoom; /* Allows normal vertical scrolling while detecting horizontal swipe */
        }

        .tab-panel {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .tab-panel.active {
            display: block;
            opacity: 1;
            transform: translateX(0);
        }

        .tab-panel.slide-left {
            animation: slideInFromRight 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .tab-panel.slide-right {
            animation: slideInFromLeft 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes slideInFromRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideInFromLeft {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .legal-hero {
            padding-top: 3rem;
            padding-bottom: 4rem;
            border-bottom: 1px solid var(--line-light);
            background: radial-gradient(circle at 80% 20%, var(--bg-soft) 0%, var(--bg-base) 70%);
        }

        .legal-body-section {
            padding: 4rem 0 6rem;
        }

        /* =====================================================================
           5. LEGAL DOCUMENT TYPOGRAPHY & STRUCTURE
           ===================================================================== */
        .legal-meta-strip {
            display: flex;
            gap: 2rem;
            margin-top: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
            flex-wrap: wrap;
        }

        .legal-meta-strip span {
            color: var(--text-primary);
        }

        .legal-document {
            display: flex;
            flex-direction: column;
            gap: 3.5rem;
            max-width: 900px;
        }

        .legal-clause {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .clause-title {
            font-family: var(--font-sans);
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--text-primary);
            letter-spacing: -0.01em;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--line-light);
        }

        .clause-text {
            color: var(--text-secondary);
            font-size: 0.98rem;
            line-height: 1.75;
        }

        .clause-subheading {
            font-family: var(--font-sans);
            font-size: 1.05rem;
            font-weight: 500;
            color: var(--text-primary);
            margin-top: 0.8rem;
        }

        .legal-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            margin: 0.5rem 0;
            padding-left: 0.5rem;
        }

        .legal-list li {
            font-size: 0.95rem;
            color: var(--text-secondary);
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            line-height: 1.6;
        }

        .legal-list li::before {
            content: "•";
            color: var(--text-muted);
            font-size: 1.1rem;
            line-height: 1.4;
        }

        .legal-contact-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem;
            margin-top: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .legal-contact-card strong {
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 1rem;
        }

        .legal-contact-card span {
            color: var(--text-secondary);
        }

        /* Supplementary Policy Grid */
        .policy-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.8rem;
            margin-top: 2rem;
        }

        .policy-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 200px;
            transition: border-color 0.25s ease, transform 0.25s ease;
        }

        .policy-card:hover {
            border-color: var(--text-muted);
            transform: translateY(-2px);
        }

        /* =====================================================================
           6. FOOTER
           ===================================================================== */
        footer {
            padding: 6rem 0 3rem;
            background: var(--bg-base);
            border-top: 1px solid var(--line);
            font-size: 0.85rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 5rem;
        }

        .footer-brand {
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .footer-brand + p {
            margin-top: 0.5rem;
            max-width: 220px;
            color: var(--text-secondary);
        }

        .footer-email {
            display: inline-block;
            margin-top: 1.4rem;
            color: var(--text-primary);
            font-weight: 500;
            border-bottom: 1px solid var(--line);
            padding-bottom: 2px;
        }

        .footer-col {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .footer-col h4 {
            margin-bottom: 0.3rem;
            color: var(--text-muted);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .footer-col a {
            color: var(--text-secondary);
            padding: 0.2rem 0;
            cursor: pointer;
        }

        .footer-col a:hover {
            color: var(--text-primary);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            border-top: 1px solid var(--line-light);
            padding-top: 2rem;
            font-size: 0.8rem;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .nav-links { display: none; }
            .policy-grid { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            /* Compact Header & Tabs on mobile */
            :root {
                --nav-height: 64px;
                --subnav-height: 48px;
            }

            .container { width: calc(100% - 2rem); }
            .subnav-container {
                gap: 1.4rem;
                padding: 0 0.5rem;
            }

            .legal-hero { padding-top: 2rem; padding-bottom: 3rem; }
            .legal-body-section { padding: 3rem 0 4.5rem; }
            .legal-meta-strip { flex-direction: column; gap: 0.5rem; }
            .legal-contact-card { padding: 1.5rem; }
        }
    </style>
</head>
