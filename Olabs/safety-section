    <script>
        document.addEventListener('DOMContentLoaded', () => {
            /* 1. Theme Toggle */
            const themeBtn = document.getElementById('theme-toggle');
            const sunIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>`;
            const moonIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>`;

            themeBtn.addEventListener('click', () => {
                document.body.classList.toggle('light-mode');
                themeBtn.innerHTML = document.body.classList.contains('light-mode') ? moonIcon : sunIcon;
            });

            /* 2. Tab Section Switching System */
            const tabPanels = document.querySelectorAll('.tab-panel');
            const subnavLinks = document.querySelectorAll('.subnav-link');
            const tabTriggerLinks = document.querySelectorAll('a[href^="#"]');

            function triggerReveals(panel) {
                const reveals = panel.querySelectorAll('.reveal');
                reveals.forEach(el => el.classList.add('visible'));
            }

            function activateTab(tabId, updateHash = true) {
                const cleanId = tabId.replace('#', '');
                const targetPanel = document.getElementById(cleanId);
                
                if (!targetPanel || !targetPanel.classList.contains('tab-panel')) return;

                tabPanels.forEach(panel => panel.classList.remove('active'));
                targetPanel.classList.add('active');
                triggerReveals(targetPanel);

                subnavLinks.forEach(link => {
                    if (link.getAttribute('href') === `#${cleanId}`) {
                        link.classList.add('active');
                    } else {
                        link.classList.remove('active');
                    }
                });

                window.scrollTo({ top: 0, behavior: 'smooth' });

                if (updateHash) {
                    history.pushState(null, '', `#${cleanId}`);
                }
            }

            tabTriggerLinks.forEach(link => {
                link.addEventListener('click', (e) => {
                    const targetId = link.getAttribute('href');
                    if (targetId && targetId.startsWith('#') && targetId.length > 1) {
                        const targetElement = document.querySelector(targetId);
                        if (targetElement && targetElement.classList.contains('tab-panel')) {
                            e.preventDefault();
                            activateTab(targetId);
                        }
                    }
                });
            });

            const currentHash = window.location.hash;
            if (currentHash && document.querySelector(currentHash)?.classList.contains('tab-panel')) {
                activateTab(currentHash, false);
            } else {
                activateTab('principles', false);
            }

            window.addEventListener('popstate', () => {
                const hash = window.location.hash || '#principles';
                activateTab(hash, false);
            });
        });
    </script>
