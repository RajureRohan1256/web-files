<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Company | Orains</title>
    <meta name="description" content="About Orains: Building the intelligence layer for engineering with geometric reasoning, CAD kernel execution, and AI-native design systems.">

    <!-- Premium Typography: Instrument Sans for UI, JetBrains Mono for Technical Data -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* =====================================================================
           1. CORE SYSTEM & VARIABLES (DARK MODE DEFAULT)
           ===================================================================== */
        :root {
            --bg-base: #0a0a0a;
            --bg-base-rgb: 10, 10, 10;
            --bg-soft: #141414;
            --bg-surface: #1e1e1e;

            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;

            --line: #2a2a2a;
            --line-light: #1a1a1a;

            --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --nav-height: 80px;
            --subnav-height: 52px;
        }

        body.light-mode {
            --bg-base: #ffffff;
            --bg-base-rgb: 255, 255, 255;
            --bg-soft: #fcfcfc;
            --bg-surface: #f5f5f4;

            --text-primary: #000000;
            --text-secondary: #555555;
            --text-muted: #888888;

            --line: #e5e5e5;
            --line-light: #f0f0f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            font-family: var(--font-sans);
            font-size: 16px;
            overflow-x: clip; /* clip prevents sticky breakdown while stopping horizontal bleed */
        }

        body {
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: clip;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        /* =====================================================================
           2. TYPOGRAPHY & SHARED UTILITIES
           ===================================================================== */
        .container {
            width: min(1320px, calc(100% - 4rem));
            margin: 0 auto;
            position: relative;
        }

        .label-sm {
            display: inline-block;
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 600;
            font-family: var(--font-mono);
        }

        .headline-xl {
            color: var(--text-primary);
            font-size: clamp(2.4rem, 5vw, 4.8rem);
            font-weight: 500;
            letter-spacing: -0.04em;
            line-height: 1.1;
            margin-bottom: 1.5rem;
        }

        .headline-md {
            color: var(--text-primary);
            font-size: clamp(1.8rem, 3.5vw, 2.8rem);
            font-weight: 500;
            letter-spacing: -0.03em;
            line-height: 1.2;
            margin-bottom: 1.25rem;
        }

        .headline-sm {
            color: var(--text-primary);
            font-size: 1.35rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            margin-bottom: 0.8rem;
        }

        .body-lg {
            color: var(--text-secondary);
            font-size: clamp(1.05rem, 1.3vw, 1.2rem);
            font-weight: 400;
            line-height: 1.65;
            max-width: 760px;
        }

        .body-md {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .link-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            padding-bottom: 3px;
            border-bottom: 1px solid var(--text-primary);
            margin-top: 1.5rem;
            cursor: pointer;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
            font-family: var(--font-sans);
        }

        .link-cta:hover {
            opacity: 0.6;
        }

        .reveal {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =====================================================================
           3. PRIMARY NAVIGATION & COMPANY SUB-NAV (BOTH FIXED ON SCROLL)
           ===================================================================== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: var(--nav-height);
            z-index: 100;
            background: rgba(var(--bg-base-rgb), 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
        }

        .nav-container {
            display: flex;
            height: 100%;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 2.2rem;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--text-primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .theme-toggle-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            transition: background-color 0.2s ease;
        }
        
        .theme-toggle-btn:hover {
            background-color: var(--line-light);
        }

        /* Fixed Company Sub-Navigation - Remains pinned below Header during scroll */
        .subnav-bar {
            position: fixed;
            top: var(--nav-height);
            left: 0;
            width: 100%;
            height: var(--subnav-height);
            z-index: 95;
            background: rgba(var(--bg-base-rgb), 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line-light);
        }

        .subnav-container {
            display: flex;
            align-items: center;
            gap: 2rem;
            height: 100%;
            overflow-x: auto;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .subnav-container::-webkit-scrollbar { display: none; }

        .subnav-link {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 0.4rem 0;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            cursor: pointer;
            flex-shrink: 0;
        }

        .subnav-link:hover {
            color: var(--text-primary);
        }

        .subnav-link.active {
            color: var(--text-primary);
            border-bottom-color: var(--text-primary);
        }

        /* =====================================================================
           4. TAB PANEL SWITCHING SYSTEM & SWIPE TRANSITIONS
           ===================================================================== */
        #company-tab-root {
            /* Offset content so it starts right below the fixed header & subnav */
            padding-top: calc(var(--nav-height) + var(--subnav-height));
            touch-action: pan-y pinch-zoom; /* Permits vertical scrolling while capturing horizontal swipe */
        }

        .tab-panel {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .tab-panel.active {
            display: block;
            opacity: 1;
            transform: translateX(0);
        }

        .tab-panel.slide-left {
            animation: slideInFromRight 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .tab-panel.slide-right {
            animation: slideInFromLeft 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes slideInFromRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideInFromLeft {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .company-hero {
            padding-top: 3rem;
            padding-bottom: 5rem;
            border-bottom: 1px solid var(--line-light);
            background: radial-gradient(circle at 80% 20%, var(--bg-soft) 0%, var(--bg-base) 70%);
        }

        .section-block {
            padding: 5rem 0;
            border-bottom: 1px solid var(--line-light);
        }

        /* =====================================================================
           5. SECTION & CARD COMPONENTS
           ===================================================================== */
        .mission-grid {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 4rem;
            margin-top: 4rem;
        }

        .statement-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .quote-lead {
            font-size: 1.25rem;
            line-height: 1.6;
            color: var(--text-primary);
            font-weight: 400;
        }

        .engine-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-top: 3.5rem;
        }

        .engine-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.8rem 2.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 320px;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }

        .engine-card:hover {
            border-color: var(--text-muted);
            transform: translateY(-3px);
        }

        .engine-tag {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-muted);
            letter-spacing: 0.1em;
            margin-bottom: 1.2rem;
            display: block;
        }

        .engine-footer-tag {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-primary);
            border-top: 1px solid var(--line-light);
            padding-top: 1.2rem;
            margin-top: 2rem;
        }

        .pipeline-strip {
            margin-top: 4rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1.2rem;
        }

        .pipeline-step {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-primary);
        }

        .pipeline-arrow {
            color: var(--text-muted);
            font-family: var(--font-mono);
        }

        .philosophy-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3.5rem;
        }

        .philosophy-card {
            border-left: 2px solid var(--line);
            padding: 1rem 0 1rem 1.8rem;
            transition: border-color 0.3s ease;
        }

        .philosophy-card:hover {
            border-left-color: var(--text-primary);
        }

        .careers-container {
            margin-top: 3.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .career-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: border-color 0.2s ease, transform 0.2s ease;
        }

        .career-card:hover {
            border-color: var(--text-muted);
            transform: translateY(-2px);
        }

        .career-meta {
            display: flex;
            gap: 1.5rem;
            margin-top: 0.5rem;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* =====================================================================
           6. FOOTER
           ===================================================================== */
        footer {
            padding: 6rem 0 3rem;
            background: var(--bg-base);
            border-top: 1px solid var(--line);
            font-size: 0.85rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 5rem;
        }

        .footer-brand {
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .footer-brand + p {
            margin-top: 0.5rem;
            max-width: 220px;
            color: var(--text-secondary);
        }

        .footer-email {
            display: inline-block;
            margin-top: 1.4rem;
            color: var(--text-primary);
            font-weight: 500;
            border-bottom: 1px solid var(--line);
            padding-bottom: 2px;
        }

        .footer-col {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .footer-col h4 {
            margin-bottom: 0.3rem;
            color: var(--text-muted);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .footer-col a {
            color: var(--text-secondary);
            padding: 0.2rem 0;
            cursor: pointer;
        }

        .footer-col a:hover {
            color: var(--text-primary);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            border-top: 1px solid var(--line-light);
            padding-top: 2rem;
            font-size: 0.8rem;
        }

        /* Team Cards */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3.5rem;
        }

        .team-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }

        .team-card:hover {
            border-color: var(--text-muted);
            transform: translateY(-3px);
        }

        .team-header {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .team-avatar-wrap {
            width: 72px;
            height: 72px;
            border-radius: 4px;
            overflow: hidden;
            background: var(--bg-surface);
            border: 1px solid var(--line);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .team-avatar {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .team-avatar-fallback {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.05em;
        }

        .team-name {
            font-size: 1.25rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        .team-role {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 0.25rem;
        }

        .team-bio {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .team-socials {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding-top: 1.2rem;
            border-top: 1px solid var(--line-light);
        }

        .team-social-link {
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .team-social-link:hover {
            color: var(--text-primary);
            transform: translateY(-1px);
        }

        .team-social-link svg {
            width: 17px;
            height: 17px;
        }

        /* =====================================================================
           7. PHONE & MOBILE RESPONSIVE OPTIMIZATIONS
           ===================================================================== */
        @media (max-width: 1024px) {
            .nav-links { display: none; }
            .mission-grid, .engine-grid, .philosophy-grid { grid-template-columns: 1fr; }
            .team-grid { grid-template-columns: repeat(2, 1fr); }
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
            .career-card { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
        }

        @media (max-width: 768px) {
            /* Compact Header & Tabs on mobile so more viewport space is available */
            :root {
                --nav-height: 64px;
                --subnav-height: 48px;
            }

            .container { width: calc(100% - 2rem); }
            .subnav-container {
                gap: 1.4rem;
                padding: 0 0.5rem;
            }

            .pipeline-strip { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
            .statement-card { padding: 2rem 1.5rem; }
            .team-grid { grid-template-columns: 1fr; }
            .company-hero { padding-top: 2rem; padding-bottom: 3.5rem; }
            .section-block { padding: 3.5rem 0; }
        }
    </style>
</head>
<body>

    <!-- Primary Navigation (Fixed) -->
    <header id="navbar">
        <div class="container nav-container">
            <a href="index.html" class="logo">Orains</a>
            <nav class="nav-links" aria-label="Primary navigation">
                <a href="product">Product</a>
                <a href="business">Business</a>
                <a href="company" class="active">Company</a>
                <a href="research">Research</a>
            </nav>
            <div class="nav-actions">
                <a href="Olabs-careers/careers" target="_blank" rel="noopener noreferrer" class="nav-cta" style="font-size: 0.85rem;">Careers &nearr;</a>
                <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Theme">
                    <svg id="theme-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Sub-Navigation for Company Sections (Fixed & Pinned directly below header) -->
    <nav class="subnav-bar" id="subnav-bar" aria-label="Company subsections">
        <div class="container subnav-container" id="subnav-scroll-container">
            <a href="#about" class="subnav-link active">About Us</a>
            <a href="#team" class="subnav-link">Team</a>
            <a href="#architecture" class="subnav-link">Core Architecture</a>
            <a href="#philosophy" class="subnav-link">Vision &amp; Philosophy</a>
            <a href="#careers" class="subnav-link">Careers</a>
        </div>
