    <main id="company-tab-root">
        <!-- =============================================================
             1. TAB: ABOUT US
             ============================================================= -->
        <div id="about" class="tab-panel active">
            <!-- Hero -->
            <section class="company-hero">
                <div class="container">
                    <span class="label-sm">ABOUT Orains</span>
                    <h1 class="headline-xl">Building the Intelligence Layer for Engineering</h1>
                    <p class="body-lg">
                        Orains is a deep-technology company building the next generation of engineering intelligence.
                    </p>
                    <div style="margin-top: 2rem;">
                        <a href="#architecture" class="link-cta link-tab">Explore the System Architecture &rarr;</a>
                    </div>
                </div>
            </section>

            <!-- Mission & Core Tenets -->
            <section class="section-block reveal">
                <div class="container">
                    <div class="mission-grid">
                        <div>
                            <span class="label-sm">FOUNDATION &amp; PURPOSE</span>
                            <h2 class="headline-md">Beyond Text: Reasoning About Physical Geometry</h2>
                            <p class="body-lg" style="margin-top: 1.5rem;">
                                We believe the future of engineering will not be defined by AI that simply understands text, but by systems that can reason about geometry, engineering constraints, physical relationships, and design intent. Our work is focused on building that foundation.
                            </p>
                            <p class="body-lg" style="margin-top: 1.25rem;">
                                At the center of our research is <strong>ORAIN — The Geometric Intelligence</strong>: an AI-native engineering system designed to understand what engineers mean, reason about how a design should work, and translate that reasoning into precise, engineering-grade geometry.
                            </p>
                        </div>

                        <div class="statement-card">
                            <div>
                                <span class="label-sm" style="color: var(--text-primary);">CORE PREMISE</span>
                                <p class="quote-lead">
                                    "Engineering knowledge, reasoning, and geometry must exist within the same computational loop."
                                </p>
                            </div>
                            <div style="margin-top: 2rem;">
                                <a href="#philosophy" class="link-cta link-tab">Read our engineering philosophy &rarr;</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        
        <!-- =============================================================
             TAB: TEAM
             ============================================================= -->
        <div id="team" class="tab-panel">
            <section class="section-block reveal">
                <div class="container">
                    <span class="label-sm">THE PEOPLE BEHIND ORAIN</span>
                    <h2 class="headline-md">Core Team &amp; Engineering</h2>
                    <p class="body-lg">
                        Pioneering geometric reasoning, AI-native CAD kernels, and computational hardware execution systems.
                    </p>
        
                    <div class="team-grid">
                        <!-- 1. Rohan Rajure -->
                        <div class="team-card">
                            <div>
