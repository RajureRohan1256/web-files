    <main>
        <!-- 1. HERO SECTION -->
        <section class="hero">
            <div class="container">
                <div class="hero-centered-content">
                    <span class="label-sm reveal">RESEARCH &amp; ENGINEERING RECRUITMENT</span>
                    <h1 class="headline-xl apple-blur">BUILD THE INTELLIGENCE OF ENGINEERING</h1>
                    <p class="hero-secondary-line reveal" style="transition-delay: 0.25s;">
                        Join us at the intersection of AI, geometry, computational engineering and design.
                    </p>
                    <div class="hero-cta-group reveal" style="transition-delay: 0.35s;">
                        <a href="#positions" class="link-cta">VIEW OPEN POSITIONS &rarr;</a>
