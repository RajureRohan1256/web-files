    <!-- Interactive Logic, Remote JSON Data, Filtering & Submission Handler -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const JOBS_JSON_PATH = 'jobs/new-jobs.json';
            const SUBMIT_ENDPOINT = 'submit-application.php';
            const MAX_LANDING_POSITIONS = 5;
            let allJobsData = [];

            /* 1. Theme Toggle Logic */
            const themeBtn = document.getElementById('theme-toggle');
            const sunIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>`;
            const moonIcon = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>`;

            if (themeBtn) {
                themeBtn.addEventListener('click', () => {
                    document.body.classList.toggle('light-mode');
                    themeBtn.innerHTML = document.body.classList.contains('light-mode') ? moonIcon : sunIcon;
                });
            }

            /* 2. Header Scroll & Mobile Drawer */
            const header = document.getElementById('navbar');
            window.addEventListener('scroll', () => {
                header.classList.toggle('scrolled', window.scrollY > 20);
            }, { passive: true });

            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileDrawer = document.getElementById('mobile-menu-drawer');
            const mobileLinks = document.querySelectorAll('.mobile-link');

            const toggleDrawer = (forceClose = false) => {
                const open = forceClose ? false : !mobileDrawer.classList.contains('open');
                mobileBtn.classList.toggle('active', open);
                mobileDrawer.classList.toggle('open', open);
                document.body.style.overflow = open ? 'hidden' : '';
            };

            if (mobileBtn && mobileDrawer) {
                mobileBtn.addEventListener('click', () => toggleDrawer());
                mobileLinks.forEach(l => l.addEventListener('click', () => toggleDrawer(true)));
            }

            /* 3. Scroll Reveal Observer */
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

            /* 4. DOM Elements */
            const jobsContainer = document.getElementById('jobs-container');
            const filterBar = document.getElementById('filter-bar');
            const jobsBottomCta = document.getElementById('jobs-bottom-cta');
            const jobsBottomCount = document.getElementById('jobs-bottom-count');
            const jobViewOverlay = document.getElementById('job-view-overlay');
            const jobViewBackBtn = document.getElementById('job-view-back-btn');
            const appForm = document.getElementById('careers-application-form');
            const submitBtn = document.getElementById('submit-btn');

            // Directory / View-All Elements
            const allCareersOverlay = document.getElementById('all-careers-overlay');
            const dirJobsContainer = document.getElementById('dir-jobs-container');
            const dirSearchInput = document.getElementById('dir-search-input');
            const dirTeamFilter = document.getElementById('dir-team-filter');
            const dirLocationFilter = document.getElementById('dir-location-filter');
            const dirSearchBtn = document.getElementById('dir-search-btn');
            const dirResetBtn = document.getElementById('dir-reset-btn');
            const dirResultsCount = document.getElementById('dir-results-count');
            const dirBackBtn = document.getElementById('dir-back-btn');

            /* 5. Render Main Filter Pills */
            const setupFilterPills = (jobs) => {
                const categories = ['all', ...new Set(jobs.map(j => j.category || j.department).filter(Boolean))];
                filterBar.innerHTML = '';

                categories.forEach((cat, index) => {
                    const btn = document.createElement('button');
                    btn.className = `filter-pill ${index === 0 ? 'active' : ''}`;
                    btn.dataset.filter = cat;
                    btn.textContent = cat === 'all' ? `All Roles (${jobs.length})` : `${cat}`;
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        renderJobs(cat);
                    });
                    filterBar.appendChild(btn);
                });
            };

            /* 6. Render Landing Page Job Listings (Max 5 items) */
            const renderJobs = (selectedCategory = 'all') => {
                jobsContainer.innerHTML = '';
                let filtered = selectedCategory === 'all' 
                    ? allJobsData 
                    : allJobsData.filter(j => (j.category === selectedCategory || j.department === selectedCategory));

                filtered = filtered.filter(job => !job.status || job.status.toLowerCase() === 'open');

                if (filtered.length === 0) {
                    jobsContainer.innerHTML = '<div class="loading-state">No open positions found in this category.</div>';
                    if (jobsBottomCta) jobsBottomCta.style.display = 'none';
                    return;
                }

                // Limit display to max 5 positions on landing page
                const visibleJobs = filtered.slice(0, MAX_LANDING_POSITIONS);

                visibleJobs.forEach(job => {
                    const row = document.createElement('a');
                    row.className = 'job-row';
                    const roleIdentifier = job.slug || job.id;
                    row.href = `?role=${encodeURIComponent(roleIdentifier)}`;
                    row.target = '_blank';
                    row.rel = 'noopener noreferrer';

                    row.innerHTML = `
                        <div class="job-title">${job.title}</div>
                        <div class="job-discipline">${job.category || job.department || 'Engineering'}</div>
                        <div class="job-location">${job.location || 'Remote'}</div>
                        <div class="job-type">${job.employmentType || 'Full-time'}</div>
                        <div class="job-action-icon">&rarr;</div>
                    `;
                    jobsContainer.appendChild(row);
                });

                // Display bottom CTA bar if more positions exist
                if (jobsBottomCta) {
                    if (filtered.length > MAX_LANDING_POSITIONS) {
                        jobsBottomCount.textContent = `Showing 5 of ${filtered.length} positions in this view.`;
                        jobsBottomCta.style.display = 'flex';
                    } else {
                        jobsBottomCta.style.display = 'none';
                    }
                }
            };

            /* 7. Setup & Render Full Directory (View All Tab) */
            const setupDirectoryFilters = (jobs) => {
                // Team Filter Options
                const teams = [...new Set(jobs.map(j => j.category || j.department).filter(Boolean))];
                dirTeamFilter.innerHTML = '<option value="all">All Teams</option>';
                teams.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t;
                    opt.textContent = t;
                    dirTeamFilter.appendChild(opt);
                });

                // Location Filter Options
                const locations = [...new Set(jobs.map(j => j.location).filter(Boolean))];
                dirLocationFilter.innerHTML = '<option value="all">All Locations</option>';
                locations.forEach(loc => {
                    const opt = document.createElement('option');
                    opt.value = loc;
                    opt.textContent = loc;
                    dirLocationFilter.appendChild(opt);
                });
            };

            const filterAndRenderDirectory = () => {
                const searchVal = (dirSearchInput.value || '').trim().toLowerCase();
                const teamVal = dirTeamFilter.value;
                const locVal = dirLocationFilter.value;

                // Shows ALL positions that match the search/filters (No 5-item limit)
                const filtered = allJobsData.filter(job => {
                    if (job.status && job.status.toLowerCase() !== 'open') return false;

                    // Filter Team
                    if (teamVal !== 'all' && (job.category || job.department) !== teamVal) {
                        return false;
                    }

                    // Filter Location
                    if (locVal !== 'all' && job.location !== locVal) {
                        return false;
                    }

                    // Filter Search Query
                    if (searchVal) {
                        const titleMatch = (job.title || '').toLowerCase().includes(searchVal);
                        const descMatch = (job.summary || job.about || '').toLowerCase().includes(searchVal);
                        const techMatch = Array.isArray(job.techStack) && job.techStack.some(t => t.toLowerCase().includes(searchVal));
                        const reqMatch = Array.isArray(job.requiredSkills || job.requirements) && (job.requiredSkills || job.requirements).some(r => r.toLowerCase().includes(searchVal));
                        
                        if (!titleMatch && !descMatch && !techMatch && !reqMatch) {
                            return false;
                        }
                    }

                    return true;
                });

                dirResultsCount.textContent = `Showing ${filtered.length} of ${allJobsData.length} available positions`;
                dirJobsContainer.innerHTML = '';

                if (filtered.length === 0) {
                    dirJobsContainer.innerHTML = '<div class="loading-state">No matching positions found. Try broadening your search or resetting filters.</div>';
                    return;
                }

                filtered.forEach(job => {
                    const row = document.createElement('a');
                    row.className = 'job-row';
                    const roleIdentifier = job.slug || job.id;
                    row.href = `?role=${encodeURIComponent(roleIdentifier)}`;
                    row.target = '_blank';
                    row.rel = 'noopener noreferrer';

                    row.innerHTML = `
                        <div class="job-title">${job.title}</div>
                        <div class="job-discipline">${job.category || job.department || 'Engineering'}</div>
                        <div class="job-location">${job.location || 'Remote'}</div>
                        <div class="job-type">${job.employmentType || 'Full-time'}</div>
                        <div class="job-action-icon">&rarr;</div>
                    `;
                    dirJobsContainer.appendChild(row);
                });
            };

            // Directory Control Listeners
            if (dirSearchInput) {
                dirSearchInput.addEventListener('input', filterAndRenderDirectory);
                dirSearchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        filterAndRenderDirectory();
                    }
                });
            }

            if (dirSearchBtn) {
                dirSearchBtn.addEventListener('click', filterAndRenderDirectory);
            }

            if (dirTeamFilter) {
                dirTeamFilter.addEventListener('change', filterAndRenderDirectory);
            }

            if (dirLocationFilter) {
                dirLocationFilter.addEventListener('change', filterAndRenderDirectory);
            }

            if (dirResetBtn) {
                dirResetBtn.addEventListener('click', () => {
                    dirSearchInput.value = '';
                    dirTeamFilter.value = 'all';
                    dirLocationFilter.value = 'all';
                    filterAndRenderDirectory();
                });
            }

            if (dirBackBtn) {
                dirBackBtn.addEventListener('click', (e) => {
                    if (window.opener) {
                        e.preventDefault();
                        window.close();
                    } else {
                        allCareersOverlay.classList.remove('active');
                        document.title = "Careers | Orains";
                    }
                });
            }

            /* 8. Populate Split View Overlay */
            const populateJobView = (job) => {
                const metaParts = [
                    job.category || job.department,
                    job.location,
                    job.employmentType,
                    job.experience
                ].filter(Boolean);

                document.getElementById('jv-discipline-loc').textContent = metaParts.join(' • ');
                document.getElementById('jv-title').textContent = job.title;
                document.getElementById('jv-oneliner').textContent = job.summary || job.about || '';
                document.getElementById('jv-problem').textContent = job.about || job.summary || '';

                // Hidden Form Fields
                document.getElementById('form-role-id').value = job.slug || job.id;
                document.getElementById('form-job-title').value = job.title;
                document.getElementById('form-job-category').value = job.category || job.department || '';

                // Responsibilities
                const respList = document.getElementById('jv-responsibilities');
                respList.innerHTML = '';
                if (job.responsibilities && Array.isArray(job.responsibilities)) {
                    respList.innerHTML = job.responsibilities.map(r => `<li>${r}</li>`).join('');
                }

                // Required Skills
                const reqList = document.getElementById('jv-requirements');
                reqList.innerHTML = '';
                const skills = job.requiredSkills || job.requirements || [];
                if (Array.isArray(skills)) {
                    reqList.innerHTML = skills.map(r => `<li>${r}</li>`).join('');
                }

                // Preferred Qualifications
                const prefSection = document.getElementById('jv-pref-section');
                const prefList = document.getElementById('jv-preferred');
                if (job.preferredQualifications && Array.isArray(job.preferredQualifications) && job.preferredQualifications.length > 0) {
                    prefList.innerHTML = job.preferredQualifications.map(p => `<li>${p}</li>`).join('');
                    prefSection.style.display = 'block';
                } else {
                    prefSection.style.display = 'none';
                }

                // Preferred Background Tags
                const bgSection = document.getElementById('jv-background-section');
                const bgTags = document.getElementById('jv-background-tags');
                if (job.preferredBackground && Array.isArray(job.preferredBackground) && job.preferredBackground.length > 0) {
                    bgTags.innerHTML = job.preferredBackground.map(t => `<span class="tag-pill">${t}</span>`).join('');
                    bgSection.style.display = 'block';
                } else {
                    bgSection.style.display = 'none';
                }

                // Tech Stack Tags
                const techSection = document.getElementById('jv-tech-section');
                const techTags = document.getElementById('jv-tech-tags');
                if (job.techStack && Array.isArray(job.techStack) && job.techStack.length > 0) {
                    techTags.innerHTML = job.techStack.map(t => `<span class="tag-pill">${t}</span>`).join('');
                    techSection.style.display = 'block';
                } else {
                    techSection.style.display = 'none';
                }

                jobViewOverlay.classList.add('active');
                window.scrollTo({ top: 0, behavior: 'instant' });
            };

            /* 9. Load Data & URL Router */
            const loadPositionsData = async () => {
                try {
                    const response = await fetch(JOBS_JSON_PATH);
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    const rawData = await response.json();
                    allJobsData = Array.isArray(rawData) ? rawData : (rawData.jobs || [rawData]);

                    setupFilterPills(allJobsData);
                    renderJobs('all');
                    setupDirectoryFilters(allJobsData);

                    // Check URL Parameters for Routing
                    const urlParams = new URLSearchParams(window.location.search);
                    const viewParam = urlParams.get('view');
                    const roleParam = urlParams.get('role');

                    if (viewParam === 'all') {
                        document.title = "Careers at Orains";
                        allCareersOverlay.classList.add('active');
                        filterAndRenderDirectory();
                    } else if (roleParam) {
                        const matched = allJobsData.find(j => (j.slug === roleParam || j.id === roleParam));
                        if (matched) {
                            document.title = `${matched.title} | Careers at Orains`;
                            populateJobView(matched);
                        }
                    }
                } catch (err) {
                    console.error('Error fetching jobs JSON:', err);
                    jobsContainer.innerHTML = `<div class="error-state">Unable to load job postings at this time. Please check back shortly or email careers@orainlabs.io.</div>`;
                    dirJobsContainer.innerHTML = `<div class="error-state">Unable to load job postings at this time.</div>`;
                }
            };

            if (jobViewBackBtn) {
                jobViewBackBtn.addEventListener('click', () => {
                    if (window.opener) {
                        window.close();
                    } else {
                        jobViewOverlay.classList.remove('active');
                        window.history.pushState({}, '', window.location.pathname);
                    }
                });
            }

            /* 10. File Upload Feedback */
            const fileInput = document.getElementById('app-resume');
            const fileChosenText = document.getElementById('file-chosen-text');
            if (fileInput && fileChosenText) {
                fileInput.addEventListener('change', () => {
                    if (fileInput.files && fileInput.files.length > 0) {
                        fileChosenText.textContent = `Selected: ${fileInput.files[0].name}`;
                        fileChosenText.style.display = 'block';
                    }
                });
            }

            /* 11. Form Handler */
            if (appForm) {
                appForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Submitting Application...';

                    const formData = new FormData(appForm);

                    try {
                        const response = await fetch(SUBMIT_ENDPOINT, {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.json();

                        if (result.success) {
                            alert('Application submitted successfully! Your submission and resume have been recorded.');
                            appForm.reset();
                            if (fileChosenText) fileChosenText.style.display = 'none';
                        } else {
                            alert('Submission failed: ' + (result.message || 'Please check all required fields.'));
                        }
                    } catch (error) {
                        console.error('Submission error:', error);
                        alert('Could not connect to the submission server. Please try again or email careers@orainlabs.io.');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = 'Submit Application &rarr;';
                    }
                });
            }

            loadPositionsData();
        });
    </script>
</body>
</html>