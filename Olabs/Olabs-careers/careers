<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <title>Careers | Orains</title>
    
    <link rel="icon" type="image/png" href="Olabs/content/orainlabs-logo.png">
    <link rel="apple-touch-icon" href="Olabs/content/orainlabs-logo.png">
    
    <meta name="description" content="Join Orains at the intersection of AI, computational geometry, engineering and design. Build systems that reason about and generate engineering geometry.">
    <meta name="keywords" content="Orains Careers, Geometric Intelligence, CAD AI, Computational Geometry, Deep Tech Jobs">

    <!-- Typography: Instrument Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        /* =====================================================================
           1. CORE DESIGN TOKENS & VARIABLES
           ===================================================================== */
        :root {
            --bg-base: #0a0a0a;
            --bg-base-rgb: 10, 10, 10;
            --bg-soft: #141414;
            --bg-surface: #1c1c1c;

            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;

            --line: #2a2a2a;
            --line-light: #1a1a1a;

            --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --nav-height: 80px;
            --radius-sm: 4px;
            --radius-md: 6px;
        }

        body.light-mode {
            --bg-base: #ffffff;
            --bg-base-rgb: 255, 255, 255;
            --bg-soft: #fcfcfc;
            --bg-surface: #f5f5f4;

            --text-primary: #000000;
            --text-secondary: #555555;
            --text-muted: #888888;

            --line: #e5e5e5;
            --line-light: #f0f0f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @keyframes siteFadeIn {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }

        @keyframes blurReveal {
            0% { 
                opacity: 0; 
                filter: blur(14px); 
                transform: scale(0.98) translateY(14px); 
            }
            100% { 
                opacity: 1; 
                filter: blur(0); 
                transform: scale(1) translateY(0); 
            }
        }

        html {
            scroll-behavior: smooth;
            font-family: var(--font-sans);
            font-size: 16px;
            overflow-x: hidden;
        }

        body {
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            animation: siteFadeIn 1.2s ease-out forwards;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        button {
            font-family: inherit;
        }

        a:focus-visible,
        button:focus-visible {
            outline: 1px solid var(--text-primary);
            outline-offset: 3px;
        }

        /* =====================================================================
           2. TYPOGRAPHY & UTILITIES
           ===================================================================== */
        .container {
            width: min(1320px, calc(100% - 4rem));
            margin: 0 auto;
            position: relative;
        }

        .label-sm {
            display: inline-block;
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 500;
        }

        .headline-xl {
            color: var(--text-primary);
            font-size: clamp(2.4rem, 5.2vw, 4.8rem);
            font-weight: 500;
            letter-spacing: -0.04em;
            line-height: 1.06;
            margin-bottom: 1.5rem;
        }

        .headline-md {
            max-width: 840px;
            color: var(--text-primary);
            font-size: clamp(2rem, 3.8vw, 3.4rem);
            font-weight: 500;
            letter-spacing: -0.03em;
            line-height: 1.12;
            margin-bottom: 1.25rem;
        }

        .body-lg {
            max-width: 640px;
            color: var(--text-secondary);
            font-size: clamp(1.05rem, 1.3vw, 1.2rem);
            font-weight: 400;
            line-height: 1.65;
        }

        .body-md {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .link-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-primary);
            font-size: 0.95rem;
            font-weight: 500;
            padding-bottom: 4px;
            border-bottom: 1px solid var(--text-primary);
            cursor: pointer;
        }

        .link-cta:hover {
            opacity: 0.65;
        }

        .link-secondary {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.95rem;
            font-weight: 500;
            padding-bottom: 4px;
            border-bottom: 1px solid transparent;
        }

        .link-secondary:hover {
            color: var(--text-primary);
            border-color: var(--text-primary);
        }

        .reveal {
            opacity: 0;
            transform: translateY(18px);
            transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .apple-blur {
            opacity: 0;
            animation: blurReveal 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
            animation-delay: 0.15s;
        }

        .section-divider {
            border-top: 1px solid var(--line-light);
        }

        /* =====================================================================
           3. NAVIGATION
           ===================================================================== */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            height: var(--nav-height);
            z-index: 100;
            background: rgba(var(--bg-base-rgb), 0.78);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid transparent;
            transition: border-color 0.4s ease, background-color 0.3s ease;
        }

        header.scrolled {
            border-bottom-color: var(--line);
        }

        .nav-container {
            display: flex;
            height: 100%;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .logo-badge {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            font-weight: 400;
            color: var(--text-muted);
            border: 1px solid var(--line);
            padding: 0.15rem 0.4rem;
            border-radius: 3px;
            letter-spacing: 0.05em;
        }

        .nav-links {
            display: flex;
            gap: 2.2rem;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.85rem;
            font-weight: 400;
        }

        .nav-links a:hover {
            color: var(--text-primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .nav-cta {
            color: var(--text-primary);
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.4rem 0;
            border-bottom: 1px solid var(--text-primary);
        }

        .theme-toggle-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            transition: opacity 0.2s ease, background-color 0.2s ease;
        }

        .mobile-menu-btn {
            display: none;
            background: transparent;
            border: none;
            cursor: pointer;
            width: 36px;
            height: 36px;
            padding: 8px;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 5px;
            border-radius: 50%;
        }

        .mobile-menu-btn .menu-bar {
            width: 18px;
            height: 1.5px;
            background-color: var(--text-primary);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
        }

        .mobile-menu-btn.active .menu-bar:nth-child(1) {
            transform: translateY(3.25px) rotate(45deg);
        }

        .mobile-menu-btn.active .menu-bar:nth-child(2) {
            transform: translateY(-3.25px) rotate(-45deg);
        }

        .mobile-menu-drawer {
            position: fixed;
            top: var(--nav-height);
            left: 0;
            width: 100%;
            height: calc(100vh - var(--nav-height));
            height: calc(100dvh - var(--nav-height));
            background: rgba(var(--bg-base-rgb), 0.96);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid var(--line);
            opacity: 0;
            pointer-events: none;
            transform: translateY(-8px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            z-index: 99;
            overscroll-behavior-y: contain;
        }

        .mobile-menu-drawer.open {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        .mobile-drawer-inner {
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem 0 4rem;
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.8rem;
        }

        .mobile-link {
            font-size: 1.5rem;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .mobile-link .mono-num {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* =====================================================================
           4. HERO & SECTIONS
           ===================================================================== */
        .hero {
            position: relative;
            min-height: 85vh;
            min-height: 85dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding-top: var(--nav-height);
            padding-bottom: 4rem;
            background: var(--bg-base);
            overflow: hidden;
        }

        .hero-centered-content {
            max-width: 960px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            z-index: 5;
        }

        .hero-secondary-line {
            font-family: var(--font-mono);
            font-size: clamp(0.85rem, 1.1vw, 0.95rem);
            color: var(--text-muted);
            letter-spacing: 0.02em;
            max-width: 680px;
            margin: 0 auto 3rem;
        }

        .hero-cta-group {
            display: flex;
            gap: 2.5rem;
            align-items: center;
            justify-content: center;
        }

        .section-problem {
            padding: 8rem 0;
            background: var(--bg-soft);
        }

        .problem-manifesto {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 4rem;
            align-items: flex-start;
            margin-bottom: 5rem;
        }

        .manifesto-text p {
            margin-bottom: 1.5rem;
            font-size: 1.15rem;
            line-height: 1.7;
            color: var(--text-secondary);
        }

        .manifesto-text p strong {
            color: var(--text-primary);
            font-weight: 500;
        }

        .manifesto-callout {
            border-left: 2px solid var(--text-primary);
            padding: 1.5rem 0 1.5rem 1.8rem;
            font-family: var(--font-mono);
            font-size: 0.9rem;
            color: var(--text-primary);
            line-height: 1.65;
            background: rgba(var(--bg-base-rgb), 0.4);
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        }

        .progression-pipeline {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 1.2rem;
            position: relative;
            margin-top: 3rem;
        }

        .pipeline-card {
            background: var(--bg-base);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 1.8rem 1.2rem;
            position: relative;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .pipeline-card:hover {
            transform: translateY(-4px);
            border-color: var(--text-secondary);
        }

        .pipeline-step-num {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-muted);
            margin-bottom: 0.8rem;
            display: block;
        }

        .pipeline-title {
            font-size: 1.05rem;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 0.6rem;
            letter-spacing: -0.01em;
        }

        .pipeline-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .pipeline-arrow {
            position: absolute;
            right: -0.8rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.9rem;
            z-index: 2;
        }

        .section-frontier {
            padding: 8rem 0;
            background: var(--bg-base);
        }

        .frontier-pipeline-box {
            margin-top: 3.5rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-md);
            padding: 3rem 2.5rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        }

        .frontier-flow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            position: relative;
        }

        .flow-node {
            background: var(--bg-base);
            border: 1px solid var(--line);
            padding: 1rem 1.4rem;
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-primary);
            letter-spacing: 0.04em;
            text-align: center;
            flex: 1;
            min-width: 170px;
        }

        .flow-node.highlight {
            border-color: var(--text-secondary);
            background: var(--bg-surface);
        }

        .flow-divider {
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.9rem;
        }

        .keyword-cluster {
            margin-top: 3rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }

        .kw-badge {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            padding: 0.4rem 0.85rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 3px;
            color: var(--text-secondary);
            transition: color 0.2s ease, border-color 0.2s ease;
        }

        .kw-badge:hover {
            color: var(--text-primary);
            border-color: var(--text-secondary);
        }

        .section-culture {
            padding: 8rem 0;
            background: var(--bg-soft);
        }

        .principles-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
            margin-top: 4rem;
        }

        .principle-box {
            background: var(--bg-base);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 2.2rem 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 220px;
        }

        .principle-num {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-muted);
            margin-bottom: 1.2rem;
        }

        .principle-box h3 {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 0.6rem;
            letter-spacing: -0.01em;
        }

        .principle-box p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.55;
        }

        .section-how-we-work-inline {
            margin-top: 5rem;
            padding-top: 4rem;
            border-top: 1px solid var(--line);
        }

        .work-style-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 2rem;
            margin-top: 2.5rem;
        }

        .work-col {
            border-left: 1px solid var(--line);
            padding-left: 1.5rem;
        }

        .work-col h4 {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            color: var(--text-primary);
            margin-bottom: 0.6rem;
            text-transform: uppercase;
        }

        .work-col p {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.55;
        }

        /* =====================================================================
           5. SECTION: OPEN POSITIONS (BUILD WITH US.)
           ===================================================================== */
        .section-positions {
            padding: 8rem 0;
            background: var(--bg-base);
        }

        .positions-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .btn-view-all-hero {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.65rem 1.3rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            font-family: var(--font-mono);
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-primary);
            transition: all 0.25s ease;
        }

        .btn-view-all-hero:hover {
            background: var(--bg-surface);
            border-color: var(--text-primary);
            transform: translateY(-2px);
        }

        .positions-filter-bar {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            margin-bottom: 2.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .filter-pill {
            background: transparent;
            border: 1px solid var(--line);
            padding: 0.45rem 1rem;
            border-radius: 20px;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .filter-pill:hover,
        .filter-pill.active {
            color: var(--text-primary);
            border-color: var(--text-primary);
            background: var(--bg-surface);
        }

        .jobs-list {
            display: flex;
            flex-direction: column;
            border-top: 1px solid var(--line);
        }

        .job-row {
            display: grid;
            grid-template-columns: 2fr 1.2fr 1fr 1fr 40px;
            align-items: center;
            padding: 1.8rem 1rem;
            border-bottom: 1px solid var(--line);
            cursor: pointer;
            transition: background-color 0.2s ease, padding-left 0.2s ease;
            text-decoration: none;
            color: inherit;
        }

        .job-row:hover {
            background-color: var(--bg-soft);
            padding-left: 1.5rem;
        }

        .job-title {
            font-size: 1.15rem;
            font-weight: 500;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .job-discipline {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        .job-location, .job-type {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .job-action-icon {
            color: var(--text-secondary);
            font-size: 1.1rem;
            text-align: right;
            transition: transform 0.2s ease;
        }

        .job-row:hover .job-action-icon {
            transform: translateX(4px);
            color: var(--text-primary);
        }

        .jobs-bottom-cta {
            margin-top: 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.2rem 1.5rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
        }

        .jobs-bottom-count {
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-secondary);
        }

        .loading-state, .error-state {
            padding: 3rem 0;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* =====================================================================
           6. DEDICATED FULL DIRECTORY VIEW: "CAREERS AT Orains"
           ==================================================================== */
        .all-careers-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: var(--bg-base);
            z-index: 180;
            overflow-y: auto;
            display: none;
        }

        .all-careers-overlay.active {
            display: block;
        }

        .all-careers-container {
            width: min(1320px, calc(100% - 4rem));
            margin: 0 auto;
            padding: 4rem 0 6rem;
        }

        .directory-header {
            margin-bottom: 3.5rem;
        }

        .directory-title {
            font-size: clamp(2.4rem, 4.5vw, 3.8rem);
            font-weight: 500;
            letter-spacing: -0.035em;
            color: var(--text-primary);
            margin-bottom: 1rem;
            line-height: 1.1;
        }

        .directory-subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
            max-width: 680px;
        }

        /* Filter & Search Bar Box */
        .directory-controls {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-md);
            padding: 1.8rem;
            margin-bottom: 3rem;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            gap: 1.2rem;
            align-items: center;
        }

        .search-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .search-input-wrap input {
            width: 100%;
            background: var(--bg-base);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 0.85rem 1rem 0.85rem 2.8rem;
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 0.92rem;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .search-input-wrap input:focus {
            border-color: var(--text-primary);
        }

        .search-icon-svg {
            position: absolute;
            left: 1rem;
            width: 18px;
            height: 18px;
            color: var(--text-muted);
            pointer-events: none;
        }

        .directory-select {
            background: var(--bg-base);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 0.85rem 1rem;
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 0.9rem;
            outline: none;
            cursor: pointer;
            transition: border-color 0.2s ease;
            width: 100%;
        }

        .directory-select:focus {
            border-color: var(--text-primary);
        }

        .directory-select option {
            background: var(--bg-surface);
            color: var(--text-primary);
        }

        .btn-search-exec {
            background: var(--text-primary);
            color: var(--bg-base);
            border: none;
            border-radius: var(--radius-sm);
            padding: 0.85rem 1.6rem;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            transition: opacity 0.2s ease;
            white-space: nowrap;
        }

        .btn-search-exec:hover {
            opacity: 0.85;
        }

        .directory-meta-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .reset-filters-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-family: var(--font-mono);
            font-size: 0.78rem;
            cursor: pointer;
            text-decoration: underline;
            padding: 0;
        }

        .reset-filters-btn:hover {
            color: var(--text-primary);
        }

        /* =====================================================================
           7. DEDICATED TAB: 2-SECTION SPLIT VIEW (JD + APPLICATION)
           ==================================================================== */
        .job-view-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: var(--bg-base);
            z-index: 200;
            overflow-y: auto;
            display: none;
        }

        .job-view-overlay.active {
            display: block;
        }

        .job-view-container {
            width: min(1380px, calc(100% - 4rem));
            margin: 0 auto;
            padding: 4rem 0 6rem;
        }

        .job-view-back {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin-bottom: 2.5rem;
            cursor: pointer;
            border-bottom: 1px solid transparent;
        }

        .job-view-back:hover {
            color: var(--text-primary);
            border-color: var(--text-primary);
        }

        /* 2-Column Split Grid */
        .job-split-grid {
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 4.5rem;
            align-items: start;
        }

        /* Section 1: Job Description Column */
        .job-desc-col {
            border-right: 1px solid var(--line);
            padding-right: 4rem;
        }

        .job-view-meta {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
            display: block;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .job-view-title {
            font-size: clamp(2.2rem, 3.6vw, 3.2rem);
            font-weight: 500;
            letter-spacing: -0.035em;
            margin-bottom: 1.2rem;
            color: var(--text-primary);
            line-height: 1.1;
        }

        .job-view-oneliner {
            font-size: 1.1rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 2.5rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--line);
        }

        .job-view-section {
            margin-bottom: 2.5rem;
        }

        .job-view-section h4 {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .job-view-section p, .job-view-section li {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.65;
        }

        .job-view-section ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .job-view-section ul li {
            position: relative;
            padding-left: 1.2rem;
        }

        .job-view-section ul li::before {
            content: "—";
            position: absolute;
            left: 0;
            color: var(--text-muted);
        }

        .tag-pill-container {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            margin-top: 0.5rem;
        }

        .tag-pill {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            padding: 0.35rem 0.7rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 3px;
            color: var(--text-primary);
        }

        /* Section 2: Application Form Column */
        .job-apply-col {
            position: sticky;
            top: 2rem;
        }

        .apply-header-title {
            font-size: 1.8rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            color: var(--text-primary);
            margin-bottom: 0.4rem;
        }

        .apply-form {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            margin-top: 2rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .form-group label {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .form-hint {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="tel"],
        .form-group select,
        .form-group textarea {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 0.75rem 1rem;
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s ease, background-color 0.2s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--text-primary);
            background-color: var(--bg-surface);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 100px;
        }

        .file-dropzone {
            border: 1px dashed var(--line);
            border-radius: var(--radius-sm);
            padding: 2rem 1.2rem;
            text-align: center;
            background: var(--bg-soft);
            cursor: pointer;
            transition: border-color 0.2s ease, background-color 0.2s ease;
            position: relative;
        }

        .file-dropzone:hover {
            border-color: var(--text-secondary);
            background-color: var(--bg-surface);
        }

        .file-dropzone input[type="file"] {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .file-dropzone-label {
            font-size: 0.9rem;
            color: var(--text-primary);
            font-weight: 500;
            margin-bottom: 0.2rem;
        }

        .file-dropzone-sub {
            font-size: 0.78rem;
            color: var(--text-muted);
            font-family: var(--font-mono);
        }

        .radio-options-row {
            display: flex;
            gap: 2rem;
            margin-top: 0.3rem;
        }

        .radio-label {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            font-size: 0.9rem;
            color: var(--text-primary);
        }

        .radio-label input[type="radio"] {
            accent-color: var(--text-primary);
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

        .legal-cert-box {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            padding: 1.4rem;
            margin-top: 0.5rem;
        }

        .legal-cert-text {
            font-size: 0.8rem;
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .legal-cert-text p + p {
            margin-top: 0.6rem;
        }

        .checkbox-label {
            display: inline-flex;
            align-items: flex-start;
            gap: 0.65rem;
            cursor: pointer;
            font-size: 0.88rem;
            color: var(--text-primary);
            font-weight: 500;
        }

        .checkbox-label input[type="checkbox"] {
            accent-color: var(--text-primary);
            width: 16px;
            height: 16px;
            margin-top: 2px;
            cursor: pointer;
        }

        .btn-submit-full {
            background: var(--text-primary);
            color: var(--bg-base);
            border: none;
            padding: 0.9rem 2rem;
            font-weight: 500;
            font-size: 0.95rem;
            cursor: pointer;
            border-radius: var(--radius-sm);
            transition: opacity 0.2s ease;
            align-self: flex-start;
            margin-top: 0.5rem;
        }

        .btn-submit-full:hover {
            opacity: 0.85;
        }

        .btn-submit-full:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* =====================================================================
           8. FINAL CTA & FOOTER
           ===================================================================== */
        .section-cta {
            padding: 9rem 0;
            background: var(--bg-soft);
            border-top: 1px solid var(--line-light);
            text-align: center;
        }

        .cta-content {
            max-width: 860px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .cta-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
            justify-content: center;
            margin-top: 3.5rem;
        }

        footer {
            padding: 6rem 0 3rem;
            background: var(--bg-base);
            border-top: 1px solid var(--line);
            font-size: 0.85rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 5rem;
        }

        .footer-brand {
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .footer-brand + p {
            margin-top: 0.5rem;
            max-width: 220px;
            font-weight: 400;
            color: var(--text-secondary);
        }

        .footer-email {
            display: inline-block;
            margin-top: 1.4rem;
            color: var(--text-primary);
            font-weight: 500;
            border-bottom: 1px solid var(--line);
            padding-bottom: 2px;
        }

        .footer-socials {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            margin-top: 1.8rem;
        }

        .footer-social-link {
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .footer-social-link:hover {
            color: var(--text-primary);
            transform: translateY(-2px);
        }

        .footer-social-link svg {
            width: 17px;
            height: 17px;
            display: block;
        }

        .footer-col {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .footer-col h4 {
            margin-bottom: 0.3rem;
            color: var(--text-muted);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .footer-col a {
            color: var(--text-secondary);
            padding: 0.2rem 0;
        }

        .footer-col a:hover {
            color: var(--text-primary);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            border-top: 1px solid var(--line-light);
            padding-top: 2rem;
            font-size: 0.8rem;
        }

        /* =====================================================================
           9. RESPONSIVE BREAKPOINTS
           ===================================================================== */
        @media (max-width: 1024px) {
            .nav-links { display: none; }
            .mobile-menu-btn { display: flex; }
            .nav-actions .nav-cta { display: none; }
            .progression-pipeline { grid-template-columns: repeat(3, 1fr); row-gap: 1.5rem; }
            .principles-grid { grid-template-columns: repeat(2, 1fr); }
            .work-style-grid { grid-template-columns: repeat(2, 1fr); }
            .footer-grid { grid-template-columns: repeat(3, 1fr); }
            .footer-grid > div:first-child { grid-column: 1 / -1; }
            .job-split-grid { grid-template-columns: 1fr; gap: 3rem; }
            .job-desc-col { border-right: none; padding-right: 0; }
            .job-apply-col { position: static; }
            .directory-controls { grid-template-columns: 1fr 1fr; }
            .directory-controls > div:first-child { grid-column: 1 / -1; }
            .btn-search-exec { grid-column: 1 / -1; }
        }

        @media (max-width: 768px) {
            :root { --nav-height: 70px; }
            .container { width: calc(100% - 2.5rem); }
            .hero { min-height: 75vh; min-height: 75dvh; }
            .headline-xl { font-size: clamp(2.2rem, 8.5vw, 3.4rem); }
            .problem-manifesto { grid-template-columns: 1fr; gap: 2rem; }
            .progression-pipeline { grid-template-columns: 1fr; }
            .principles-grid { grid-template-columns: 1fr; }
            .work-style-grid { grid-template-columns: 1fr; }
            .job-row { grid-template-columns: 1fr; gap: 0.4rem; padding: 1.5rem 0; }
            .hero-cta-group, .cta-links { flex-direction: column; gap: 1.5rem; }
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column-reverse; align-items: flex-start; gap: 1.2rem; }
            .radio-options-row { flex-direction: column; gap: 0.8rem; }
            .directory-controls { grid-template-columns: 1fr; }
            .jobs-bottom-cta { flex-direction: column; gap: 1rem; text-align: center; }
        }

        @media (prefers-reduced-motion: reduce) {
            .reveal, .apple-blur { 
                opacity: 1 !important; 
                filter: none !important; 
                transform: none !important; 
                transition: none !important; 
                animation: none !important; 
            }
            html { scroll-behavior: auto; }
            body { animation: none; }
        }
    </style>
</head>
