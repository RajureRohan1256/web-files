<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Products &amp; Technology Stack — Orain Labs</title>
    <meta name="description" content="Explore the ORAIN technology stack: ORAIN Forge CAD kernel, PAXX 1.0 API, Geometric Engine planning layer, ERE reasoning, and VSE interactive visualization.">

    <!-- Premium Typography: Instrument Sans for UI, JetBrains Mono for Technical Data -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        /* =====================================================================
           1. CORE SYSTEM & VARIABLES (DARK MODE DEFAULT)
           ===================================================================== */
        :root {
            --bg-base: #0a0a0a;
            --bg-base-rgb: 10, 10, 10;
            --bg-soft: #141414;
            --bg-surface: #1e1e1e;

            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --text-muted: #666666;

            --line: #2a2a2a;
            --line-light: #1a1a1a;

            --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --nav-height: 80px;
            --subnav-height: 52px;
        }

        body.light-mode {
            --bg-base: #ffffff;
            --bg-base-rgb: 255, 255, 255;
            --bg-soft: #fcfcfc;
            --bg-surface: #f5f5f4;

            --text-primary: #000000;
            --text-secondary: #555555;
            --text-muted: #888888;

            --line: #e5e5e5;
            --line-light: #f0f0f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            font-family: var(--font-sans);
            font-size: 16px;
            overflow-x: hidden;
        }

        body {
            background: var(--bg-base);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        a {
            color: inherit;
            text-decoration: none;
            transition: opacity 0.2s ease, color 0.2s ease;
        }

        /* =====================================================================
           2. TYPOGRAPHY & SHARED UTILITIES
           ===================================================================== */
        .container {
            width: min(1320px, calc(100% - 4rem));
            margin: 0 auto;
            position: relative;
        }

        .label-sm {
            display: inline-block;
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 600;
            font-family: var(--font-mono);
        }

        .headline-xl {
            color: var(--text-primary);
            font-size: clamp(2.4rem, 5vw, 4.6rem);
            font-weight: 500;
            letter-spacing: -0.04em;
            line-height: 1.12;
            margin-bottom: 1.5rem;
        }

        .headline-md {
            color: var(--text-primary);
            font-size: clamp(1.8rem, 3.2vw, 2.6rem);
            font-weight: 500;
            letter-spacing: -0.03em;
            line-height: 1.2;
            margin-bottom: 1.25rem;
        }

        .headline-sm {
            color: var(--text-primary);
            font-size: 1.3rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            margin-bottom: 0.8rem;
        }

        .body-lg {
            color: var(--text-secondary);
            font-size: clamp(1.05rem, 1.3vw, 1.2rem);
            font-weight: 400;
            line-height: 1.65;
            max-width: 780px;
        }

        .body-md {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .link-cta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 500;
            padding-bottom: 3px;
            border-bottom: 1px solid var(--text-primary);
            margin-top: 1.5rem;
            cursor: pointer;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
            font-family: var(--font-sans);
        }

        .link-cta:hover {
            opacity: 0.6;
        }

        .reveal {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =====================================================================
           3. NAVIGATION
           ===================================================================== */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            height: var(--nav-height);
            z-index: 100;
            background: rgba(var(--bg-base-rgb), 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
        }

        .nav-container {
            display: flex;
            height: 100%;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .nav-links {
            display: flex;
            gap: 2.2rem;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--text-primary);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .theme-toggle-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            transition: background-color 0.2s ease;
        }
        
        .theme-toggle-btn:hover {
            background-color: var(--line-light);
        }

        /* Sticky Products Sub-Navigation */
        .subnav-bar {
            position: sticky;
            top: var(--nav-height);
            width: 100%;
            height: var(--subnav-height);
            z-index: 90;
            background: rgba(var(--bg-base-rgb), 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--line-light);
        }

        .subnav-container {
            display: flex;
            align-items: center;
            gap: 2rem;
            height: 100%;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .subnav-container::-webkit-scrollbar { display: none; }

        .subnav-link {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-muted);
            white-space: nowrap;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 0.4rem 0;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .subnav-link:hover {
            color: var(--text-primary);
        }

        .subnav-link.active {
            color: var(--text-primary);
            border-bottom-color: var(--text-primary);
        }

        /* =====================================================================
           4. TAB PANEL SYSTEM
           ===================================================================== */
        .tab-panel {
            display: none;
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

        .tab-panel.active {
            display: block;
            opacity: 1;
            transform: translateY(0);
            animation: panelFadeIn 0.35s ease forwards;
        }

        @keyframes panelFadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .product-hero {
            padding-top: calc(var(--nav-height) + 2.5rem);
            padding-bottom: 6rem;
            border-bottom: 1px solid var(--line-light);
            background: radial-gradient(circle at 80% 20%, var(--bg-soft) 0%, var(--bg-base) 70%);
        }

        .section-block {
            padding: 6rem 0;
            border-bottom: 1px solid var(--line-light);
        }

        .tab-panel > .section-block:first-child:not(.product-hero) {
            padding-top: calc(var(--nav-height) + 2.5rem);
        }

        /* =====================================================================
           5. PRODUCT ARCHITECTURE, CARDS & GRIDS
           ===================================================================== */
        .cards-grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.8rem;
            margin-top: 3.5rem;
        }

        .cards-grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-top: 3.5rem;
        }

        .product-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.5rem 2.2rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 300px;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }

        .product-card:hover {
            border-color: var(--text-muted);
            transform: translateY(-3px);
        }

        .badge-mono {
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--text-muted);
            letter-spacing: 0.1em;
            margin-bottom: 1.2rem;
            display: block;
        }

        .tag-footer {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-primary);
            border-top: 1px solid var(--line-light);
            padding-top: 1.2rem;
            margin-top: 2rem;
        }

        .pipeline-strip {
            margin-top: 4rem;
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 2.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .pipeline-step {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-primary);
        }

        .pipeline-arrow {
            color: var(--text-muted);
            font-family: var(--font-mono);
        }

        .spec-list {
            list-style: none;
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .spec-list li {
            font-family: var(--font-mono);
            font-size: 0.84rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .spec-list li::before {
            content: "•";
            color: var(--text-muted);
        }

        .feature-tag-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1.8rem;
        }

        .feature-pill {
            background: var(--bg-base);
            border: 1px solid var(--line);
            padding: 0.5rem 0.9rem;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--text-primary);
        }

        .code-window {
            background: var(--bg-base);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            line-height: 1.7;
            color: #d1d5db;
            overflow-x: auto;
            margin-top: 1.5rem;
        }

        .code-window .code-comment { color: var(--text-muted); }
        .code-window .code-key { color: #93c5fd; }
        .code-window .code-str { color: #86efac; }
        .code-window .code-num { color: #fca5a5; }

        .statement-card {
            background: var(--bg-soft);
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* =====================================================================
           6. FOOTER
           ===================================================================== */
        footer {
            padding: 6rem 0 3rem;
            background: var(--bg-base);
            border-top: 1px solid var(--line);
            font-size: 0.85rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
            gap: 3rem;
            margin-bottom: 5rem;
        }

        .footer-brand {
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--text-primary);
        }

        .footer-brand + p {
            margin-top: 0.5rem;
            max-width: 220px;
            color: var(--text-secondary);
        }

        .footer-email {
            display: inline-block;
            margin-top: 1.4rem;
            color: var(--text-primary);
            font-weight: 500;
            border-bottom: 1px solid var(--line);
            padding-bottom: 2px;
        }

        .footer-col {
            display: flex;
            flex-direction: column;
            gap: 0.9rem;
        }

        .footer-col h4 {
            margin-bottom: 0.3rem;
            color: var(--text-muted);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .footer-col a {
            color: var(--text-secondary);
            padding: 0.2rem 0;
            cursor: pointer;
        }

        .footer-col a:hover {
            color: var(--text-primary);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            border-top: 1px solid var(--line-light);
            padding-top: 2rem;
            font-size: 0.8rem;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1024px) {
            .nav-links { display: none; }
            .cards-grid-3, .cards-grid-2 { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .container { width: calc(100% - 2.5rem); }
            .pipeline-strip { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
            .statement-card { padding: 2rem 1.5rem; }
        }
    </style>
</head>
