    <main id="product-tab-root">
        <!-- =============================================================
             1. TAB: THE ORAIN STACK & OVERVIEW
             ============================================================= -->
        <div id="orain-stack" class="tab-panel active">
            <!-- Hero -->
            <section class="product-hero">
                <div class="container">
                    <span class="label-sm">ORAIN &bull; THE GEOMETRIC INTELLIGENCE</span>
                    <h1 class="headline-xl">One System. One Intelligence.</h1>
                    <p class="body-lg">
                        ORAIN is an AI-native engineering system designed to understand engineering intent, reason about design, construct precise geometry, and make complex engineering workflows more intelligent.
                    </p>
                    <div style="margin-top: 2rem;">
                        <a href="#orain-forge" class="link-cta link-tab">Explore ORAIN Forge Construction Kernel &rarr;</a>
                    </div>
                </div>
            </section>

            <!-- Unified Stack Architecture Section -->
            <section class="section-block reveal">
                <div class="container">
                    <span class="label-sm">SPECIALIZED INTELLIGENCE LAYERS</span>
                    <h2 class="headline-md">Behind ORAIN: The Unified Technology Stack</h2>
                    <p class="body-lg">
                        ORAIN is not a collection of disconnected engineering tools. It is a unified intelligence system built from specialized layers that allow machines to move from intent to reasoning, reasoning to geometry, and geometry to an engineering-ready representation.
                    </p>

                    <div class="cards-grid-3">
                        <!-- Layer 01: PAXX 1.0 -->
                        <div class="product-card">
                            <div>
                                <span class="badge-mono">INTERFACE LAYER // 01</span>
                                <h3 class="headline-sm">PAXX 1.0</h3>
                                <p class="body-md">
                                    Exposes ORAIN's capabilities through structured APIs, connecting external software and platforms to the underlying intelligence stack.
                                </p>
                            </div>
                            <div class="tag-footer">APPLICATION &rarr; PAXX &rarr; ORAIN</div>
                        </div>

                        <!-- Layer 02: ERE -->
                        <div class="product-card">
                            <div>
                                <span class="badge-mono">REASONING LAYER // 02</span>
                                <h3 class="headline-sm">ERE Engine</h3>
                                <p class="body-md">
                                    Evaluates design intent, constraints, relationships, and feasibility before geometry is constructed to determine what makes engineering sense.
                                </p>
                            </div>
                            <div class="tag-footer">ENGINEERING REASONING ENGINE</div>
                        </div>

                        <!-- Layer 03: Geometric Engine -->
                        <div class="product-card">
                            <div>
                                <span class="badge-mono">PLANNING LAYER // 03</span>
                                <h3 class="headline-sm">Geometric Engine</h3>
                                <p class="body-md">
                                    Translates engineering reasoning into structured geometric representations, organizing features, dimensions, constraints, and dependencies.
                                </p>
                            </div>
                            <div class="tag-footer">GEOMETRIC PLANNING LAYER</div>
                        </div>

                        <!-- Layer 04: ORAIN Forge -->
                        <div class="product-card">
                            <div>
                                <span class="badge-mono">CONSTRUCTION LAYER // 04</span>
                                <h3 class="headline-sm">ORAIN Forge</h3>
                                <p class="body-md">
                                    Executes the geometric plan and constructs precise engineering geometry using robust, topology-aware CAD-kernel technology.
                                </p>
                            </div>
                            <div class="tag-footer">CAD-KERNEL B-REP EXECUTION</div>
                        </div>

                        <!-- Layer 05: VSE -->
                        <div class="product-card">
                            <div>
                                <span class="badge-mono">VISUALIZATION LAYER // 05</span>
                                <h3 class="headline-sm">VSE Sub-Engine</h3>
                                <p class="body-md">
                                    Provides the visual representation layer, allowing engineers to inspect and interact with design states while remaining decoupled from kernel logic.
                                </p>
                            </div>
                            <div class="tag-footer">VISUALIZATION &amp; INSPECTION</div>
                        </div>

                        <!-- Architecture Statement -->
                        <div class="product-card" style="background: var(--bg-base); border-color: var(--line);">
